# ================= удары с оружием: где хват и куда смотрит оружие (в долях роста; x — влево, y — вверх, z — вперёд) =================
static func W(p: Array, d: Array, extra := {}) -> Dictionary:
	var r := {"r": {"p": p, "d": d}}
	for k in extra:
		r[k] = extra[k]
	return r

## Пахан: Балон VOZDUH за горлышко, донышко наружу. Стойка — бутылка опущена вдоль правой ноги, донышко чуть вперёд.
const PH_HOLD := [-0.17, 0.31, 0.07]
const PH_DIR := [-0.42, -0.82, 0.4]   # как бита на референсе: вниз, наружу вправо и чуть вперёд
static func pahan_armed() -> Dictionary:
	var A := pahan()
	var idle_ik := W(PH_HOLD, PH_DIR)
	for k in A["Idle"]["k"]:
		k.append(idle_ik)
	# бег: бутылка ходит вперёд-назад вместе с рукой
	var run: Array = A["Run"]["k"]
	var sw := [[-0.15, 0.31, 0.12], [-0.15, 0.3, 0.04], [-0.15, 0.31, -0.06], [-0.15, 0.3, 0.04], [-0.15, 0.31, 0.12]]
	var sd := [[0.05, -0.7, 0.7], [0.05, -0.9, 0.4], [0.05, -0.85, -0.5], [0.05, -0.9, 0.4], [0.05, -0.7, 0.7]]
	for i in run.size():
		run[i].append(W(sw[i], sd[i]))
	var st := {"rup": {"x": -0.25}, "lup": {"x": 0.15}, "rleg": {"x": 0.2}, "lleg": {"x": 0.25}, "drop": 0.03}
	# 1) с размаха справа налево: бутылка заведена за правое плечо → проходит перед собой → уходит влево
	A["Light1"] = {"d": 1.0, "k": [[0.0, ph({}), idle_ik],
		[0.3, ph(add(st, {"spine": {"y": -0.55}, "spine2": {"y": -0.3}, "head": {"y": 0.3}})), W([-0.2, 0.47, -0.05], [-0.55, 0.45, -0.7])],
		[0.5, ph(add(st, {"spine": {"y": 0.45}, "spine2": {"y": 0.25}})), W([-0.02, 0.43, 0.2], [0.45, 0.05, 0.9])],
		[0.7, ph(add(st, {"spine": {"y": 0.6}, "spine2": {"y": 0.3}})), W([0.12, 0.4, 0.1], [0.95, -0.1, -0.2])],
		[1.0, ph({}), idle_ik]]}
	# 2) наотмашь слева направо: бутылка над левым плечом → удар вправо
	A["Light2"] = {"d": 1.0, "k": [[0.0, ph({}), idle_ik],
		[0.3, ph(add(st, {"spine": {"y": 0.45}, "spine2": {"y": 0.25}})), W([0.08, 0.52, 0.06], [0.7, 0.5, -0.5])],
		[0.52, ph(add(st, {"spine": {"y": -0.45}, "spine2": {"y": -0.25}})), W([-0.08, 0.42, 0.21], [-0.55, -0.05, 0.83])],
		[0.72, ph(add(st, {"spine": {"y": -0.6}})), W([-0.2, 0.38, 0.07], [-0.9, -0.25, -0.3])],
		[1.0, ph({}), idle_ik]]}
	# 3) сверху вниз: замах над головой, бутылка смотрит назад → удар перед собой вниз
	A["Light3"] = {"d": 1.0, "k": [[0.0, ph({}), idle_ik],
		[0.3, ph(add(st, {"spine": {"x": -0.2}, "head": {"x": -0.1}})), W([-0.09, 0.68, 0.0], [-0.05, 0.4, -0.92])],
		[0.48, ph(add(st, {"spine": {"x": 0.35}, "spine2": {"x": 0.15}, "drop": 0.05})), W([-0.05, 0.38, 0.22], [0.0, -0.55, 0.83])],
		[0.7, ph(add(st, {"spine": {"x": 0.3}, "drop": 0.05})), W([-0.06, 0.3, 0.17], [0.0, -0.9, 0.4])],
		[1.0, ph({}), idle_ik]]}
	# тяжёлый: двумя руками сверху, вторая рука ниже по бутылке
	A["Heavy"] = {"d": 1.0, "k": [[0.0, ph({}), idle_ik],
		[0.35, ph(add(st, {"spine": {"x": -0.3}, "spine2": {"x": -0.15}, "head": {"x": -0.15}})), W([-0.04, 0.72, -0.02], [0.0, 0.25, -0.97], {"two": 0.07})],
		[0.55, ph(add(st, {"spine": {"x": 0.5}, "spine2": {"x": 0.2}, "drop": 0.1, "rleg": {"x": 0.25}})), W([-0.03, 0.34, 0.24], [0.0, -0.7, 0.7], {"two": 0.07})],
		[0.78, ph(add(st, {"spine": {"x": 0.45}, "drop": 0.1})), W([-0.03, 0.27, 0.2], [0.0, -0.95, 0.3], {"two": 0.07})],
		[1.0, ph({}), idle_ik]]}
	# блок: бутылка поперёк груди, вторая рука держит её за корпус
	var bl := W([-0.07, 0.43, 0.17], [1.0, 0.18, 0.05], {"two": 0.13})
	A["Block"] = {"d": 1.0, "loop": true, "k": [[0.0, ph({"spine": {"x": 0.12}}), bl], [1.0, ph({"spine": {"x": 0.12}}), bl]]}
	A["Rage"] = {"d": 1.0, "k": [[0.0, ph({}), idle_ik], [0.3, ph({"spine": {"x": -0.3}, "head": {"x": -0.4}, "larm": {"x": -2.6, "z": 0.6}}), W([-0.12, 0.78, 0.0], [0.0, 1.0, 0.1])],
		[0.7, ph({"spine": {"x": -0.25}, "head": {"x": -0.35}, "larm": {"x": -2.5, "z": 0.5}}), W([-0.12, 0.76, 0.02], [0.0, 1.0, 0.15])], [1.0, ph({}), idle_ik]]}
	# --- в стиле Slugger (Yakuza 0): широкие махи, добивания по числу ударов, вертушка, полный замах с зарядом ---
	# 4-й лёгкий: «вертушка» — рука с балоном вытянута в сторону, корпус крутит контроллер
	var out := W([-0.36, 0.47, 0.02], [-1.0, 0.05, 0.1])
	A["Spin"] = {"d": 1.0, "loop": true, "k": [[0.0, ph(add(st, {"spine": {"x": 0.1}})), out], [1.0, ph(add(st, {"spine": {"x": 0.1}})), out]]}
	# полный замах двумя руками: балон за правым плечом (заряд) → широкая дуга справа налево на уровне груди
	var wind := W([-0.2, 0.55, -0.12], [-0.35, 0.55, -0.75], {"two": 0.07})
	A["Charge"] = {"d": 1.0, "loop": true, "k": [[0.0, ph(add(st, {"spine": {"y": -0.75}, "spine2": {"y": -0.35}, "head": {"y": 0.5}, "drop": 0.05})), wind],
		[0.5, ph(add(st, {"spine": {"y": -0.8}, "spine2": {"y": -0.38}, "head": {"y": 0.52}, "drop": 0.06})), W([-0.21, 0.56, -0.13], [-0.37, 0.56, -0.74], {"two": 0.07})],
		[1.0, ph(add(st, {"spine": {"y": -0.75}, "spine2": {"y": -0.35}, "head": {"y": 0.5}, "drop": 0.05})), wind]]}
	A["FullSwing"] = {"d": 1.0, "k": [[0.0, ph(add(st, {"spine": {"y": -0.75}, "spine2": {"y": -0.35}, "head": {"y": 0.5}, "drop": 0.05})), wind],
		[0.3, ph(add(st, {"spine": {"y": -0.1}, "drop": 0.07})), W([-0.08, 0.47, 0.22], [-0.3, 0.1, 0.95], {"two": 0.07})],
		[0.48, ph(add(st, {"spine": {"y": 0.7}, "spine2": {"y": 0.35}, "drop": 0.07})), W([0.16, 0.48, 0.12], [0.95, 0.15, 0.1], {"two": 0.07})],
		[0.75, ph(add(st, {"spine": {"y": 0.9}, "spine2": {"y": 0.45}, "drop": 0.05})), W([0.18, 0.55, -0.06], [0.6, 0.55, -0.6], {"two": 0.07})],
		[1.0, ph({}), idle_ik]]}
	# добивание с земли (Heat): балон над головой двумя руками → удар вниз
	A["Smash"] = {"d": 1.0, "k": [[0.0, ph({}), idle_ik],
		[0.4, ph(add(st, {"spine": {"x": -0.35}, "head": {"x": -0.2}})), W([-0.03, 0.78, -0.03], [0.0, 0.3, -0.95], {"two": 0.07})],
		[0.55, ph(add(st, {"spine": {"x": 0.75}, "spine2": {"x": 0.3}, "drop": 0.16, "rleg": {"x": 0.4}, "lleg": {"x": 0.4}})), W([-0.02, 0.22, 0.3], [0.0, -0.85, 0.5], {"two": 0.07})],
		[0.8, ph(add(st, {"spine": {"x": 0.7}, "drop": 0.16})), W([-0.02, 0.2, 0.28], [0.0, -0.95, 0.3], {"two": 0.07})],
		[1.0, ph({}), idle_ik]]}
	for k in A["Hit"]["k"]:
		k.append(idle_ik)
	return A

## Враги без оружия (бот): кулаки, удар правой.
static func bot() -> Dictionary:
	return enemy()

## Клиппер: катана двумя руками. Стойка тюдан — клинок вперёд-вверх на уровне горла противника,
## правая рука у цубы, левая у конца рукояти. Удар — кэса-гири: от правого плеча наискосок к левому бедру всем телом.
static func clipper() -> Dictionary:
	var A := enemy()
	var st := {"rup": {"x": -0.3}, "lup": {"x": 0.2}, "rleg": {"x": 0.3}, "lleg": {"x": 0.35}, "drop": 0.04, "spine": {"x": 0.05}}
	var chudan := W([-0.03, 0.38, 0.15], [0.0, 0.62, 0.78], {"two": -0.1})
	A["Idle"] = {"d": 2.0, "loop": true, "k": [[0.0, en(st), chudan], [0.5, en(add(st, {"spine": {"x": 0.03}, "drop": 0.01})), W([-0.03, 0.37, 0.15], [0.0, 0.6, 0.8], {"two": -0.1})], [1.0, en(st), chudan]]}
	var run: Array = A["Run"]["k"]
	for i in run.size():
		run[i].append(W([-0.03, 0.38 - 0.01 * (i % 2), 0.14], [0.0, 0.7, 0.71], {"two": -0.1}))
	A["Slash"] = {"d": 1.0, "k": [[0.0, en(st), chudan],
		[0.32, en(add(st, {"spine": {"y": -0.45}, "spine2": {"y": -0.2}})), W([-0.1, 0.64, 0.03], [-0.25, 0.75, -0.6], {"two": -0.1})],
		[0.52, en(add(st, {"spine": {"y": 0.35, "x": 0.15}, "drop": 0.06})), W([0.06, 0.33, 0.2], [0.55, -0.4, 0.73], {"two": -0.1})],
		[0.72, en(add(st, {"spine": {"y": 0.45, "x": 0.18}, "drop": 0.06})), W([0.1, 0.29, 0.1], [0.75, -0.6, 0.25], {"two": -0.1})],
		[1.0, en(st), chudan]]}
	for k in A["Hit"]["k"]:
		k.append(chudan)
	for k in A["Spawn"]["k"]:
		k.append(W([-0.02, 0.37 - 0.2 * (k[1].get("drop", 0.0)), 0.17], [0.0, 0.42, 0.9], {"two": -0.1}))
	return A

## Хейтер: посох в правой руке посередине, вертикально, как опора. Каст — посох поднят высоко, затем выброшен навершием вперёд.
static func hater() -> Dictionary:
	var A := enemy()
	var hold := W([-0.17, 0.33, 0.07], [0.0, 1.0, 0.06])
	for k in A["Idle"]["k"]:
		k.append(hold)
	var run: Array = A["Run"]["k"]
	for i in run.size():
		run[i].append(W([-0.17, 0.33, 0.07 + 0.04 * sin(i * PI / 2)], [0.0, 1.0, 0.15]))
	A["Cast"] = {"d": 1.0, "k": [[0.0, en({}), hold],
		[0.4, en({"spine": {"x": -0.22}, "head": {"x": -0.15}, "larm": {"x": -1.0}}), W([-0.09, 0.67, 0.05], [0.05, 1.0, -0.12])],
		[0.6, en({"spine": {"x": 0.28}, "larm": {"x": -1.4}, "lfa": {"x": -0.3}, "drop": 0.03}), W([-0.05, 0.45, 0.21], [0.0, 0.55, 0.84])],
		[0.8, en({"spine": {"x": 0.22}, "larm": {"x": -1.2}}), W([-0.06, 0.43, 0.19], [0.0, 0.6, 0.8])],
		[1.0, en({}), hold]]}
	for k in A["Hit"]["k"]:
		k.append(hold)
	for k in A["Spawn"]["k"]:
		k.append(W([-0.17, 0.33 - 0.25 * (k[1].get("drop", 0.0)), 0.07], [0.0, 1.0, 0.06]))
	return A
