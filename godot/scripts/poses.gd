# ================= удары с оружием: где хват и куда смотрит оружие (в долях роста; x — влево, y — вверх, z — вперёд) =================
static func W(p: Array, d: Array, extra := {}) -> Dictionary:
	var r := {"r": {"p": p, "d": d}}
	for k in extra:
		r[k] = extra[k]
	return r

## Пахан: Балон VOZDUH за горлышко, донышко наружу. Стойка — бутылка опущена вдоль правой ноги, донышко чуть вперёд.
const PH_HOLD := [-0.19, 0.275, -0.05]
const PH_DIR := [-0.3, -0.5, -0.81]   # вниз и назад-вправо: конец балона лежит на земле за спиной
## Скрутка корпуса: h — таз, s — грудь (плюс — влево), lean — наклон вперёд; голова остаётся смотреть на цель.
static func tw(h: float, s: float, lean := 0.0) -> Dictionary:
	return {"hips": {"y": h}, "spine": {"y": s, "x": lean}, "spine2": {"y": s * 0.6}, "head": {"y": clampf(-(h + s * 1.6) * 0.75, -0.8, 0.8), "x": -lean * 0.5}}

## бег с балоном: корпус наклонён вперёд и в сторону от груза, таз развёрнут к балону
static func mkd(o: Dictionary) -> Dictionary:
	return add(add(MKD, {"spine": {"x": 0.14, "z": -0.07}, "hips": {"y": -0.1}, "larm": {"z": 0.12}}), o)

## Пахан с балоном. Балон — тяжёлый металл: на весу его не держат, он стоит концом на земле позади-справа,
## на ходу волочится следом (отставание и инерцию добавляет drag.gd поверх анимации).
## Удар — как двуручником из Dark Souls:
##  — подготовка: присед, вес назад, балон с усилием отрывается от земли;
##  — размах: корпус идёт первым, балон отстаёт и разгоняется медленно ("in");
##  — удар: дуга через цель на полной скорости;
##  — завершение: балон тащит руку и корпус дальше и падает на землю;
##  — восстановление: балон волоком возвращается за спину.
## Время удара в клипе совпадает с "hits" в player.gd; "drop" там же — когда балон падает на землю.
static func pahan_armed() -> Dictionary:
	var A := pahan()
	var idle_ik := W(PH_HOLD, PH_DIR)
	for k in A["Idle"]["k"]:
		k.append(idle_ik)
	A["Idle"]["ease"] = "io"
	A["Idle"]["ground"] = true
	# бег: балон волочится концом по земле позади, рука вытянута назад и почти не качается
	A["Run"] = {"d": 0.5, "loop": true, "smooth": true, "k": run_keys(Callable(Poses, "mkd"))}
	var run: Array = A["Run"]["k"]
	for i in run.size():
		var s := cos(i / 8.0 * TAU)
		run[i][1]["larm"] = {"z": -1.13, "x": -0.75 * s}   # свободная рука работает за двоих
		run[i].append(W([-0.19, 0.285 + 0.006 * cos(i / 4.0 * TAU), -0.06 - 0.015 * s], [-0.22, -0.5, -0.84]))
	var T2 := {"two": 0.07}
	var lfw := {"lup": {"x": -0.55}, "lleg": {"x": 0.6}, "rup": {"x": 0.3}, "rleg": {"x": 0.2}}
