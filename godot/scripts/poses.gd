## Удары врагов: замах тормозит, удар разгоняется, довод гаснет
static func _accent(def: Dictionary) -> void:
	var e := ["", "out", "in", "out2", "io"]
	var keys: Array = def["k"]
	for i in range(1, min(keys.size(), e.size())):
		keys[i].append(e[i])

## Враги без оружия (бот): кулаки, удар правой.
static func bot() -> Dictionary:
	var A := enemy()
	_accent(A["Punch"])
	_accent(A["Cast"])
	_accent(A["Slash"])
	return A

## Клиппер: катана двумя руками. Стойка тюдан — клинок вперёд-вверх на уровне горла противника,
## правая рука у цубы, левая у конца рукояти. Удар — кэса-гири: от правого плеча наискосок к левому бедру всем телом.
static func clipper() -> Dictionary:
	var A := enemy()
	var st := {"rup": {"x": -0.3}, "lup": {"x": 0.2}, "rleg": {"x": 0.3}, "lleg": {"x": 0.35}, "drop": 0.04, "spine": {"x": 0.05}}
	var chudan := W([-0.03, 0.38, 0.15], [0.0, 0.62, 0.78], {"two": -0.1})
	A["Idle"] = {"d": 2.0, "loop": true, "k": [[0.0, en(st), chudan], [0.5, en(add(st, {"spine": {"x": 0.03}, "drop": 0.01})), W([-0.03, 0.37, 0.15], [0.0, 0.6, 0.8], {"two": -0.1})], [1.0, en(st), chudan]]}
	var run: Array = A["Run"]["k"]
	for i in run.size():
		run[i].append(W([-0.03, 0.38 - 0.01 * (i % 2), 0.14], [0.0, 0.7, 0.71], {"two": -0.1}))
	A["Slash"] = {"d": 1.0, "k": [[0.0, en(st), chudan],
		[0.32, en(add(st, {"spine": {"y": -0.45}, "spine2": {"y": -0.2}})), W([-0.1, 0.64, 0.03], [-0.25, 0.75, -0.6], {"two": -0.1})],
		[0.52, en(add(st, {"spine": {"y": 0.35, "x": 0.15}, "drop": 0.06})), W([0.06, 0.33, 0.2], [0.55, -0.4, 0.73], {"two": -0.1})],
		[0.72, en(add(st, {"spine": {"y": 0.45, "x": 0.18}, "drop": 0.06})), W([0.1, 0.29, 0.1], [0.75, -0.6, 0.25], {"two": -0.1})],
		[1.0, en(st), chudan]]}
	_accent(A["Slash"])
	_accent(A["Punch"])
	for k in A["Hit"]["k"]:
		k.append(chudan)
	for k in A["Spawn"]["k"]:
		k.append(W([-0.02, 0.37 - 0.2 * (k[1].get("drop", 0.0)), 0.17], [0.0, 0.42, 0.9], {"two": -0.1}))
	return A

## Хейтер: посох в правой руке посередине, вертикально, как опора. Каст — посох поднят высоко, затем выброшен навершием вперёд.
static func hater() -> Dictionary:
	var A := enemy()
	var hold := W([-0.17, 0.33, 0.07], [0.0, 1.0, 0.06])
	for k in A["Idle"]["k"]:
		k.append(hold)
	var run: Array = A["Run"]["k"]
	for i in run.size():
		run[i].append(W([-0.17, 0.33, 0.07 + 0.04 * sin(i * PI / 2)], [0.0, 1.0, 0.15]))
	A["Cast"] = {"d": 1.0, "k": [[0.0, en({}), hold],
		[0.4, en({"spine": {"x": -0.22}, "head": {"x": -0.15}, "larm": {"x": -1.0}}), W([-0.09, 0.67, 0.05], [0.05, 1.0, -0.12])],
		[0.6, en({"spine": {"x": 0.28}, "larm": {"x": -1.4}, "lfa": {"x": -0.3}, "drop": 0.03}), W([-0.05, 0.45, 0.21], [0.0, 0.55, 0.84])],
		[0.8, en({"spine": {"x": 0.22}, "larm": {"x": -1.2}}), W([-0.06, 0.43, 0.19], [0.0, 0.6, 0.8])],
		[1.0, en({}), hold]]}
	_accent(A["Cast"])
	_accent(A["Punch"])
	for k in A["Hit"]["k"]:
		k.append(hold)
	for k in A["Spawn"]["k"]:
		k.append(W([-0.17, 0.33 - 0.25 * (k[1].get("drop", 0.0)), 0.07], [0.0, 1.0, 0.06]))
	return A
