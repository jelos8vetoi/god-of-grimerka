## Позы и анимации, собранные из поворотов костей (порт из браузерной версии).
## Поза — словарь { кость: { ось: угол } }; оси — в осях персонажа: x — его левая рука, y — вверх, z — вперёд.
## «drop» — насколько опустить таз (доля его высоты). Ключи анимации: [время 0..1, поза].
class_name Poses

static func add(base: Dictionary, o: Dictionary) -> Dictionary:
	var r := {}
	for k in base:
		r[k] = base[k].duplicate() if base[k] is Dictionary else base[k]
	for k in o:
		if k == "drop" or k == "lift":
			r[k] = o[k]
			continue
		var cur: Dictionary = r[k].duplicate() if r.has(k) else {}
		for a in o[k]:
			cur[a] = cur.get(a, 0.0) + o[k][a]
		r[k] = cur
	return r

# ---------- Пахан: стоит, удерживая тяжёлый балон за горлышко; конец балона — на земле позади-справа ----------
const PHS := {
	"hips": {"y": -0.05}, "spine": {"x": 0.08, "y": -0.05, "z": -0.06}, "head": {"x": -0.1, "z": 0.05}, "neck": {"y": 0.06},
	"rarm": {"z": 1.12, "x": -0.12}, "rfa": {"x": -0.22}, "larm": {"z": -1.3, "x": 0.05}, "lfa": {"x": -0.12},
	"rup": {"z": -0.13, "x": -0.04}, "lup": {"z": 0.16, "x": 0.03}, "lleg": {"x": 0.1},
}

static func ph(o: Dictionary) -> Dictionary:
	return add(PHS, o)

# ---------- Пахан в меню паузы: расслабленно откинулся, одна нога поднята и согнута, кулак у головы, слушает музыку ----------
## Сам наклон тела назад делает сцена паузы (поворот всего рига), здесь — только кости.
const PAUSE := {
	"hips": {"y": 0.2}, "spine": {"x": -0.1, "y": 0.08}, "spine1": {"x": -0.08, "z": 0.06}, "neck": {"x": 0.08}, "head": {"x": 0.1, "z": -0.14, "y": -0.18},
	"rup": {"x": -1.3, "z": -0.22}, "rleg": {"x": 1.5}, "rfoot": {"x": -0.25},
	"lup": {"x": 0.22, "z": 0.14}, "lleg": {"x": 0.4}, "lfoot": {"x": 0.45},
	"rarm": {"z": 0.95, "x": -0.35}, "rfa": {"x": -0.55}, "larm": {"z": -0.4, "x": -0.3}, "lfa": {"x": -1.2},
}
const PAUSE_FIST := {"l": {"p": [0.2, 0.585, 0.09], "d": [0.15, 1.0, 0.2]}}   # левый кулак поднят у головы

static func pahan_pause() -> Dictionary:
	var st := ph({})
	var S := PAUSE
	var F := PAUSE_FIST
	var nod_a := add(S, {"head": {"x": 0.1, "z": 0.05}, "neck": {"x": 0.04}, "rsh": {"z": 0.03}, "spine1": {"y": 0.02}, "rleg": {"x": 0.07}, "rup": {"x": -0.03}})
	var nod_b := add(S, {"head": {"x": 0.1, "z": -0.05}, "neck": {"x": 0.04}, "lsh": {"z": -0.03}, "spine1": {"y": -0.02}, "rleg": {"x": -0.04}})
	var breath := add(S, {"spine": {"x": -0.02}, "spine1": {"x": -0.015}, "head": {"x": 0.02}, "rleg": {"x": 0.03}})
	return {
		"Idle": {"d": 3.0, "loop": true, "k": [[0.0, st], [0.5, add(st, {"spine": {"x": -0.02}})], [1.0, st]]},
		# вход: выпрямился → вес назад, нога пошла вверх → расслабленная поза
		"PauseEnter": {"d": 0.5, "n": 24, "k": [[0.0, st], [0.28, add(st, {"spine": {"x": -0.1}, "rup": {"x": -0.6}, "rleg": {"x": 0.9}, "head": {"x": -0.05}}), "out"], [0.72, add(S, {"rup": {"x": -0.12}, "spine": {"x": -0.05}}), F, "io"], [1.0, S, F, "out"]]},
		# музыка играет: голова кивает в такт, плечи и поднятая нога чуть ходят
		"PauseMusicIdle": {"d": 1.9, "loop": true, "n": 40, "ease": "io", "k": [[0.0, S, F], [0.25, nod_a, F], [0.5, S, F], [0.75, nod_b, F], [1.0, S, F]]},
		# музыки нет: только дыхание
		"PauseIdle": {"d": 3.8, "loop": true, "n": 32, "ease": "io", "k": [[0.0, S, F], [0.5, breath, F], [1.0, S, F]]},
		"PauseExit": {"d": 0.35, "n": 20, "k": [[0.0, S, F], [0.45, add(st, {"spine": {"x": -0.08}, "rup": {"x": -0.5}, "rleg": {"x": 0.8}}), "io"], [1.0, st, "out"]]},
	}

# ---------- руки опущены: база для кента и врагов ----------
const MKD := {"rarm": {"z": 1.25}, "larm": {"z": -1.25}}
const ENB := {"rarm": {"z": 1.2}, "larm": {"z": -1.2}, "rfa": {"x": -0.25}, "lfa": {"x": -0.25}, "spine": {"x": 0.06}}

static func mk(o: Dictionary) -> Dictionary:
	return add(MKD, o)

static func en(o: Dictionary) -> Dictionary:
	return add(ENB, o)

## Цикл бега из восьми поз: касание → просадка → пронос → толчок, затем то же с другой ноги.
## Таз пружинит (drop), корпус наклонён и чуть скручивается против ног, руки ходят в противоход.
const RUN_HALF := [
	# бедро и голень ведущей ноги, бедро и голень толчковой, просадка таза
	[-0.78, 0.22, 0.5, 0.85, 0.0],
	[-0.45, 0.6, 0.25, 1.45, 0.04],
	[-0.05, 0.3, -0.42, 1.35, 0.015],
	[0.36, 0.38, -0.82, 0.8, -0.015],
]
static func run_keys(base_fn: Callable) -> Array:
	var keys := []
	for i in 9:
		var h: Array = RUN_HALF[i % 4]
		var right_leads := (i % 8) < 4
		var s := cos(i / 8.0 * TAU)   # +1 — правая нога впереди, −1 — левая
		var o := {"spine": {"x": 0.2, "y": -0.1 * s}, "head": {"y": 0.06 * s, "x": -0.06}, "rfa": {"x": -1.25}, "lfa": {"x": -1.25},
			"rarm": {"x": 0.6 * s}, "larm": {"x": -0.6 * s}, "drop": h[4]}
		o["rup" if right_leads else "lup"] = {"x": h[0]}
		o["rleg" if right_leads else "lleg"] = {"x": h[1]}
		o["lup" if right_leads else "rup"] = {"x": h[2]}
		o["lleg" if right_leads else "rleg"] = {"x": h[3]}
		keys.append([i / 8.0, base_fn.call(o)])
	return keys

