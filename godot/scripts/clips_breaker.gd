## Breaker Style madk1d: движения брейка как боевые клипы. Без оружия — бьют ноги.
## Вращения тела задаёт атака (spin), прыжок — extra.hop; здесь позы и опора: руки на полу стоят через IK кисти.
## У madk1d большая голова и короткие руки: в стойке вниз головой он стоит на голове, а не на вытянутых руках —
## поэтому вращение на голове (headspin); ладони упираются в пол по бокам от головы.
class_name BreakerClips

static func hand(side: String, p: Array) -> Dictionary:
	return {side: {"p": p, "d": [0.0, 0.0, 1.0]}}

static func add_to(A: Dictionary) -> void:
	var g := MadkClips.mg({})
	var sq := {"rup": {"x": -0.6}, "rleg": {"x": 0.95}, "lup": {"x": -0.6}, "lleg": {"x": 0.95}}
	# toprock: шаг накрест с качем корпуса и короткий удар ногой вперёд
	A["Toprock"] = {"d": 1.0, "ground": true, "n": 40, "k": [[0.0, g],
		[0.25, MadkClips.mg({"hips": {"y": -0.3}, "spine": {"y": 0.3, "x": -0.05}, "lup": {"x": -0.2, "z": -0.25}, "lleg": {"x": 0.5}, "rarm": {"z": -0.5}, "larm": {"z": 0.5}}), "out"],
		[0.5, MadkClips.mg({"hips": {"y": 0.2}, "spine": {"x": -0.25, "y": -0.2}, "rup": {"x": -1.35}, "rleg": {"x": 0.1}, "larm": {"z": 0.7}, "rarm": {"z": -0.4}}), "in"],
		[0.7, MadkClips.mg({"hips": {"y": 0.2}, "spine": {"x": -0.2, "y": -0.2}, "rup": {"x": -1.2}, "rleg": {"x": 0.5}, "larm": {"z": 0.6}}), "out2"], [1.0, g, "io"]]}
	# подсечка: упор на руку, одна нога согнута под собой, другая вытянута и метёт по кругу (тело крутит spin)
	var sweep: Dictionary = Poses.mk({"spine": {"x": 0.55, "z": 0.25}, "head": {"x": -0.4}, "drop": 0.55, "lup": {"x": -1.4}, "lleg": {"x": 2.0}, "rup": {"x": -0.9, "z": -0.9}, "rleg": {"x": 0.05}, "rarm": {"z": -0.6}})
	var lh := hand("l", [0.16, 0.03, 0.14])
	A["LegSweep"] = {"d": 1.0, "n": 40, "k": [[0.0, g], [0.22, sweep, lh, "out"], [0.78, Poses.add(sweep, {"rup": {"z": -0.1}}), lh, "lin"], [1.0, g, "io"]]}
	# вертолёт: прыжок, корпус откинут, ноги в шпагате по горизонтали (тело крутит spin)
	var heli: Dictionary = Poses.mk({"hips": {"x": -0.75}, "spine": {"x": 0.35}, "head": {"x": 0.3}, "drop": 0.15, "lup": {"x": -0.5, "z": 1.05}, "lleg": {"x": 0.1}, "rup": {"x": -0.5, "z": -1.05}, "rleg": {"x": 0.1},
		"larm": {"z": 0.9}, "rarm": {"z": -0.9}})
	A["Helicopter"] = {"d": 1.0, "n": 40, "k": [[0.0, g], [0.14, MadkClips.mg(Poses.add(sq, {"spine": {"x": 0.3}})), "out"], [0.3, heli, "out"], [0.8, Poses.add(heli, {"hips": {"x": -0.1}}), "lin"], [1.0, MadkClips.mg(sq), "in"]]}
	# вращение на голове: тело вниз головой, ноги разведены вверх, руки в стороны для баланса (тело крутит spin)
	var inv: Dictionary = Poses.mk({"hips": {"x": 3.0}, "spine": {"x": 0.1}, "drop": -0.1, "lup": {"z": 0.75, "x": 0.2}, "lleg": {"x": 0.15}, "rup": {"z": -0.75, "x": 0.2}, "rleg": {"x": 0.15},
		"larm": {"z": 0.9}, "rarm": {"z": -0.9}})
	var ih := {"l": {"p": [0.17, 0.03, 0.08], "d": [0.0, 0.0, 1.0]}, "r": {"p": [-0.17, 0.03, 0.08], "d": [0.0, 0.0, 1.0]}}     # ладони в пол по бокам от головы
	A["HeadSpin"] = {"d": 1.0, "n": 48, "k": [[0.0, g],
		[0.12, MadkClips.mg(Poses.add(sq, {"spine": {"x": 0.7}, "drop": 0.3})), "out"],
		[0.26, Poses.mk({"hips": {"x": 1.7}, "spine": {"x": 0.3}, "drop": 0.05, "lup": {"x": -0.8}, "rup": {"x": -0.8}, "lleg": {"x": 1.0}, "rleg": {"x": 1.0}}), "in"],
		[0.38, inv, ih, "out"], [0.8, Poses.add(inv, {"lup": {"z": 0.15}, "rup": {"z": -0.15}}), ih, "lin"],
		[0.92, Poses.mk({"hips": {"x": 1.2}, "spine": {"x": 0.4}, "drop": 0.1, "lup": {"x": -1.0}, "rup": {"x": -1.0}, "lleg": {"x": 1.3}, "rleg": {"x": 1.3}}), "in"], [1.0, MadkClips.mg(sq), "out"]]}
	# флэр: сидя на руках позади таза, ноги широким кругом над землёй (тело крутит spin)
	var hands := {"l": {"p": [0.15, 0.03, -0.14], "d": [0.0, 0.0, 1.0]}, "r": {"p": [-0.15, 0.03, -0.14], "d": [0.0, 0.0, 1.0]}}
	var flare: Dictionary = Poses.mk({"hips": {"x": -0.55}, "spine": {"x": 0.35}, "head": {"x": 0.15}, "drop": 0.6, "lup": {"x": -1.1, "z": 0.95}, "lleg": {"x": 0.05}, "rup": {"x": -1.1, "z": -0.95}, "rleg": {"x": 0.05}})
	A["Flare"] = {"d": 1.0, "n": 40, "k": [[0.0, g], [0.2, flare, hands, "out"], [0.8, Poses.add(flare, {"hips": {"z": 0.2}}), hands, "lin"], [1.0, MadkClips.mg(sq), "io"]]}
	# фриз в бою: упор на руки, корпус набок, ноги сложены вверх — застыл
	var frz: Dictionary = Poses.mk({"hips": {"x": 1.2, "z": 0.35}, "spine": {"x": 0.5}, "head": {"x": -0.6, "z": 0.35}, "drop": 0.55, "rup": {"x": 0.75, "z": -0.2}, "rleg": {"x": 1.5}, "lup": {"x": 0.35, "z": 0.3}, "lleg": {"x": 1.1}})
	var fh := {"l": {"p": [0.1, 0.03, 0.18], "d": [0.0, 0.0, 1.0]}, "r": {"p": [-0.1, 0.03, 0.2], "d": [0.0, 0.0, 1.0]}}
	A["FreezePose"] = {"d": 1.0, "n": 40, "k": [[0.0, g], [0.14, Poses.mk(Poses.add(sq, {"spine": {"x": 0.6}, "drop": 0.3})), fh, "out"], [0.26, frz, fh, "out"], [1.0, frz, fh, "lin"]]}
	# из фриза или с земли: толчок ногами вверх — и на ногах
	A["KickUp"] = {"d": 1.0, "n": 40, "k": [[0.0, frz, fh],
		[0.3, Poses.mk({"hips": {"x": -0.9}, "spine": {"x": -0.2}, "drop": 0.5, "rup": {"x": -1.7}, "lup": {"x": -1.7}, "rleg": {"x": 0.4}, "lleg": {"x": 0.4}, "rarm": {"x": 0.6}, "larm": {"x": 0.6}}), "out"],
		[0.5, Poses.mk({"lift": 0.0, "hips": {"x": -0.3}, "spine": {"x": -0.3}, "drop": 0.1, "rup": {"x": -1.5}, "rleg": {"x": 0.1}, "lup": {"x": -0.4}, "lleg": {"x": 0.9}, "rarm": {"z": -0.6}, "larm": {"z": 0.6}}), "in"],
		[0.75, MadkClips.mg(sq), "out"], [1.0, g, "io"]]}
