## Breaker madk1d — второй набор: стойка-качалка (toprock), вариация покоя, CC kick, бэкспин, обратная подсечка,
## удар из стойки на руках, вращение на одной руке, сальто назад с ударом, ответ двумя ногами, финал из фриза.
## Вращение тела и прыжок задаёт атака (spin, extra.hop), здесь — позы и опора рук на пол через IK.
## У madk1d короткие руки и большая голова: вниз головой он стоит на голове, ладони — по бокам от неё.
class_name BreakerSet

static func add_to(A: Dictionary) -> void:
	var g := MadkClips.mg({})
	var sq := {"rup": {"x": -0.6}, "rleg": {"x": 0.95}, "lup": {"x": -0.6}, "lleg": {"x": 0.95}}
	var D := [0.0, 0.0, 1.0]
	var ih := {"l": {"p": [0.17, 0.03, 0.08], "d": D}, "r": {"p": [-0.17, 0.03, 0.08], "d": D}}      # ладони в пол по бокам от головы
	var back_h := {"l": {"p": [0.15, 0.03, -0.14], "d": D}, "r": {"p": [-0.15, 0.03, -0.14], "d": D}}   # руки в пол позади таза
	# ---------- стойка ----------
	# toprock: вес с ноги на ногу, корпус качается, руки ходят накрест
	var tl: Dictionary = MadkClips.mg({"hips": {"y": -0.22}, "spine": {"y": 0.25, "x": 0.05}, "lup": {"x": -0.35, "z": -0.12}, "lleg": {"x": 0.55}, "rup": {"x": 0.05}, "rleg": {"x": 0.2}, "larm": {"x": -0.5, "z": 0.3}, "rarm": {"x": 0.3, "z": -0.5}})
	var xf: Dictionary = MadkClips.mg({"hips": {"y": 0.22}, "spine": {"y": -0.25, "x": 0.05}, "rup": {"x": -0.35, "z": 0.12}, "rleg": {"x": 0.55}, "lup": {"x": 0.05}, "lleg": {"x": 0.2}, "rarm": {"x": -0.5, "z": -0.3}, "larm": {"x": 0.3, "z": 0.5}})
	A["BrIdle"] = {"d": 1.0, "loop": true, "ground": true, "ease": "io", "k": [[0.0, tl], [0.25, MadkClips.mg({"drop": 0.02})], [0.5, xf], [0.75, MadkClips.mg({"drop": 0.02})], [1.0, tl]]}
	# вариация покоя: прокатил плечи и обозначил удар рукой
	A["BrIdleVar"] = {"d": 2.2, "ground": true, "k": [[0.0, g],
		[0.2, MadkClips.mg({"spine": {"y": 0.35, "z": 0.1}, "larm": {"x": 0.5, "z": 0.3}, "rarm": {"x": -0.6}}), "io"],
		[0.4, MadkClips.mg({"spine": {"y": -0.35, "z": -0.1}, "rarm": {"x": 0.5, "z": -0.3}, "larm": {"x": -0.6}}), "io"],
		[0.58, MadkClips.mg({"spine": {"y": 0.3, "x": 0.1}, "rarm": {"x": -1.4}, "rfa": {"x": -0.3}, "hips": {"y": 0.2}}), "in"],
		[0.72, MadkClips.mg({"spine": {"y": -0.1}, "rarm": {"x": -0.6}, "rfa": {"x": -1.4}}), "out"],
		[1.0, g, "io"]]}
	# ---------- удары с пола ----------
	# CC kick: присел на правую руку и левую ногу, правая нога выстреливает вперёд по голени
	var cc_fold: Dictionary = Poses.mk({"spine": {"x": 0.5, "z": -0.2}, "head": {"x": -0.4}, "drop": 0.52, "lup": {"x": -1.4}, "lleg": {"x": 2.0}, "rup": {"x": -1.5}, "rleg": {"x": 1.7}, "larm": {"z": 0.7}})
	var rh := {"r": {"p": [-0.17, 0.03, 0.1], "d": D}}
	A["CCKick"] = {"d": 1.0, "n": 40, "k": [[0.0, g], [0.28, cc_fold, rh, "out"],
		[0.5, Poses.add(cc_fold, {"rup": {"x": -1.45}, "rleg": {"x": 0.03}, "spine": {"x": 0.35}}), rh, "in"],
		[0.68, Poses.add(cc_fold, {"rup": {"x": -1.4}, "rleg": {"x": 0.3}}), rh, "out2"], [1.0, g, "io"]]}
	# обратная подсечка: зеркало обычной — упор на правую руку, левая нога метёт в другую сторону
	var rsweep: Dictionary = Poses.mk({"spine": {"x": 0.55, "z": -0.25}, "head": {"x": -0.4}, "drop": 0.55, "rup": {"x": -1.4}, "rleg": {"x": 2.0}, "lup": {"x": -0.9, "z": 0.9}, "lleg": {"x": 0.05}, "larm": {"z": 0.6}})
	var rh2 := {"r": {"p": [-0.16, 0.03, 0.14], "d": D}}
	A["RevSweep"] = {"d": 1.0, "n": 40, "k": [[0.0, g], [0.22, rsweep, rh2, "out"], [0.78, Poses.add(rsweep, {"lup": {"z": 0.1}}), rh2, "lin"], [1.0, g, "io"]]}
	# бэкспин: на спине, колени к груди, ноги поочерёдно выбрасываются наружу (тело крутит spin)
	var bs: Dictionary = Poses.mk({"hips": {"x": -1.4}, "spine": {"x": 0.55}, "head": {"x": 0.55}, "drop": 0.74, "lup": {"x": -1.7, "z": 0.45}, "lleg": {"x": 1.3}, "rup": {"x": -1.2, "z": -0.6}, "rleg": {"x": 0.1},
		"larm": {"z": 0.9}, "rarm": {"z": -0.9}})
	A["Backspin"] = {"d": 1.0, "n": 48, "k": [[0.0, g],
		[0.12, MadkClips.mg(Poses.add(sq, {"spine": {"x": -0.1}, "drop": 0.35})), "out"],
		[0.25, bs, "out"],
		[0.5, Poses.add(bs, {"lup": {"x": 0.5, "z": 0.15}, "lleg": {"x": -1.2}, "rup": {"x": -0.5, "z": 0.15}, "rleg": {"x": 1.2}}), "lin"],
		[0.75, bs, "lin"],
		[0.9, Poses.mk({"hips": {"x": -0.7}, "spine": {"x": 0.2}, "drop": 0.45, "rup": {"x": -1.6}, "lup": {"x": -1.6}, "rleg": {"x": 1.2}, "lleg": {"x": 1.2}}), "in"],
		[1.0, MadkClips.mg(sq), "out"]]}
	# ---------- стойка на руках ----------
	var inv: Dictionary = Poses.mk({"hips": {"x": 3.0}, "spine": {"x": 0.1}, "drop": -0.1, "lup": {"z": 0.75, "x": 0.2}, "lleg": {"x": 0.15}, "rup": {"z": -0.75, "x": 0.2}, "rleg": {"x": 0.15}})
	# удар из стойки: руки в пол, ноги через верх — и передняя нога рубит сверху вниз по цели
	A["HandKick"] = {"d": 1.0, "n": 48, "k": [[0.0, g],
		[0.16, MadkClips.mg(Poses.add(sq, {"spine": {"x": 0.75}, "drop": 0.28})), ih, "out"],
		[0.32, Poses.mk({"hips": {"x": 2.0}, "spine": {"x": 0.25}, "drop": 0.0, "lup": {"x": -1.3}, "lleg": {"x": 0.2}, "rup": {"x": 0.7}, "rleg": {"x": 0.9}}), ih, "out"],
		[0.5, Poses.mk({"hips": {"x": 3.6}, "spine": {"x": 0.05}, "drop": -0.05, "lup": {"x": -1.5}, "lleg": {"x": 0.05}, "rup": {"x": 0.9}, "rleg": {"x": 1.3}}), ih, "in"],
		[0.72, Poses.mk({"hips": {"x": 4.9}, "spine": {"x": 0.35}, "drop": 0.2, "lup": {"x": -1.2}, "lleg": {"x": 0.8}, "rup": {"x": -0.4}, "rleg": {"x": 1.1}}), "out"],
		[1.0, Poses.mk(Poses.add(sq, {"hips": {"x": 6.283}, "spine": {"x": 0.3}})), "io"]]}
	# вращение на одной руке: вниз головой, ноги ножницами, свободная рука в сторону (тело крутит spin)
	var lh1 := {"l": {"p": [0.17, 0.03, 0.08], "d": D}}
	var hs: Dictionary = Poses.add(inv, {"hips": {"z": 0.28}, "lup": {"x": -0.9, "z": 0.4}, "rup": {"x": 0.8, "z": -0.4}, "rarm": {"z": -1.2}})
	A["HandSpin"] = {"d": 1.0, "n": 48, "k": [[0.0, g],
		[0.12, MadkClips.mg(Poses.add(sq, {"spine": {"x": 0.7}, "drop": 0.3})), "out"],
		[0.26, Poses.mk({"hips": {"x": 1.7, "z": 0.2}, "spine": {"x": 0.3}, "drop": 0.05, "lup": {"x": -0.8}, "rup": {"x": -0.8}, "lleg": {"x": 1.0}, "rleg": {"x": 1.0}}), lh1, "in"],
		[0.4, hs, lh1, "out"],
		[0.6, Poses.add(hs, {"lup": {"x": 0.8, "z": 0.4}, "rup": {"x": -0.9, "z": -0.4}}), lh1, "lin"],
		[0.8, hs, lh1, "lin"],
		[0.92, Poses.mk({"hips": {"x": 1.2}, "spine": {"x": 0.4}, "drop": 0.1, "lup": {"x": -1.0}, "rup": {"x": -1.0}, "lleg": {"x": 1.3}, "rleg": {"x": 1.3}}), "in"], [1.0, MadkClips.mg(sq), "out"]]}
	# ---------- акробатика ----------
	# сальто назад с ударом: ноги уходят вверх первыми и бьют снизу, тело делает полный оборот назад
	var tuck := {"rup": {"x": -1.7}, "lup": {"x": -1.7}, "rleg": {"x": 1.9}, "lleg": {"x": 1.9}, "rarm": {"x": -0.6}, "larm": {"x": -0.6}}
	A["Backflip"] = {"d": 1.0, "n": 56, "k": [[0.0, g],
		[0.14, MadkClips.mg(Poses.add(sq, {"spine": {"x": 0.25}, "rarm": {"x": 0.7}, "larm": {"x": 0.7}})), "out"],
		[0.3, Poses.mk({"hips": {"x": -1.2}, "spine": {"x": -0.3}, "lift": 0.08, "rup": {"x": -1.9}, "rleg": {"x": 0.1}, "lup": {"x": -1.2}, "lleg": {"x": 1.2}, "rarm": {"x": -2.0}, "larm": {"x": -2.0}}), "in"],
		[0.5, Poses.mk(Poses.add(tuck, {"hips": {"x": -2.8}, "lift": 0.14})), "lin"],
		[0.7, Poses.mk(Poses.add(tuck, {"hips": {"x": -4.5}, "lift": 0.1})), "lin"],
		[0.88, Poses.mk(Poses.add(sq, {"hips": {"x": -6.0}, "spine": {"x": 0.3}})), "out"],
		[1.0, Poses.mk(Poses.add(sq, {"hips": {"x": -6.283}, "spine": {"x": 0.2}})), "io"]]}
	# ответ: упал на руки позади себя и выстрелил обеими ногами вперёд
	A["BrCounter"] = {"d": 1.0, "n": 40, "k": [[0.0, g],
		[0.28, Poses.mk({"hips": {"x": -0.5}, "spine": {"x": 0.2}, "drop": 0.5, "rup": {"x": -1.7}, "lup": {"x": -1.7}, "rleg": {"x": 1.8}, "lleg": {"x": 1.8}}), back_h, "out"],
		[0.48, Poses.mk({"hips": {"x": -0.85}, "spine": {"x": 0.1}, "head": {"x": 0.3}, "drop": 0.42, "rup": {"x": -1.25}, "lup": {"x": -1.25}, "rleg": {"x": 0.02}, "lleg": {"x": 0.02}}), back_h, "in"],
		[0.66, Poses.mk({"hips": {"x": -0.7}, "spine": {"x": 0.15}, "drop": 0.45, "rup": {"x": -1.3}, "lup": {"x": -1.3}, "rleg": {"x": 0.4}, "lleg": {"x": 0.4}}), back_h, "out2"],
		[0.84, MadkClips.mg(sq), "out"], [1.0, g, "io"]]}
	# финал: застыл в фризе — и взорвался: ноги шпагатом по кругу в прыжке (тело крутит spin), приземление в присед
	var frz: Dictionary = Poses.mk({"hips": {"x": 1.2, "z": 0.35}, "spine": {"x": 0.5}, "head": {"x": -0.6, "z": 0.35}, "drop": 0.55, "rup": {"x": 0.75, "z": -0.2}, "rleg": {"x": 1.5}, "lup": {"x": 0.35, "z": 0.3}, "lleg": {"x": 1.1}})
	var fh := {"l": {"p": [0.1, 0.03, 0.18], "d": D}, "r": {"p": [-0.1, 0.03, 0.2], "d": D}}
	var split: Dictionary = Poses.mk({"hips": {"x": -0.6}, "spine": {"x": 0.3}, "head": {"x": 0.25}, "lift": 0.06, "lup": {"x": -0.4, "z": 1.15}, "lleg": {"x": 0.05}, "rup": {"x": -0.4, "z": -1.15}, "rleg": {"x": 0.05},
		"larm": {"z": 1.1}, "rarm": {"z": -1.1}})
	A["BrFinal"] = {"d": 1.0, "n": 56, "k": [[0.0, frz, fh], [0.2, frz, fh, "lin"],
		[0.3, Poses.mk({"hips": {"x": 0.3}, "spine": {"x": 0.4}, "drop": 0.35, "rup": {"x": -1.2}, "lup": {"x": -1.2}, "rleg": {"x": 1.6}, "lleg": {"x": 1.6}}), "in"],
		[0.42, split, "out"], [0.8, Poses.add(split, {"hips": {"x": 0.1}}), "lin"],
		[0.92, MadkClips.mg(Poses.add(sq, {"drop": 0.12, "spine": {"x": 0.35}})), "in"], [1.0, MadkClips.mg(sq), "out"]]}
